---
/*
 * About page. The text (bio, book and show lists) lives in src/content/pages/about.md:
 * edit it there, like a post. This file only lays out the photo and that text.
 * The social links (under the photo, and in the footer) come from SOCIAL in src/config.ts.
 */
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portrait from '../assets/images/about/portrait.jpg';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description="Tentang Bimanjaya." lang={page.data.lang}>
  <h1>{page.data.title}</h1>

  <Image
    src={portrait}
    alt="me sitting at a cafe. captured by my beloved"
    widths={[320, 640]}
    sizes="20rem"
    class="portrait"
  />

  <div class="about-social">
    <SocialLinks />
  </div>

  <div class="about-body">
    <Content />
  </div>
</BaseLayout>

<style>
  .portrait {
    width: 100%;
    max-width: 20rem;            /* a portrait photo at full column width would be very tall */
    height: auto;
    margin: var(--space-m) auto 0;  /* auto left/right margins centre it in the column */
  }

  /* The same icons as in the footer, centred under the photo. */
  .about-social {
    display: flex;
    justify-content: center;
    margin-block: var(--space-s) var(--space-m);
  }
</style>
