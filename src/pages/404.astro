---
// Shown for any URL that doesn't exist. The build outputs it as dist/404.html,
// which hosts (Cloudflare included) serve for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <h1>Page not found</h1>
  <p>There's nothing at this address. Try the <a href="/">home page</a> or the <a href="/blog/">blog</a>.</p>
</BaseLayout>
