---
/*
 * One page per post: a "dynamic route". The [slug] in the file name is a placeholder.
 * At build time Astro calls getStaticPaths(), which returns one entry per post;
 * Astro then builds this page once for each, with that post's slug in the URL.
 */
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },   // fills in [slug] → /blog/<id>/
    props: { post },             // handed to this page as Astro.props
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);   // the Markdown body, turned into HTML
---

<PostLayout post={post}>
  <Content />
</PostLayout>
