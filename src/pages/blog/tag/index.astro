---
// All tags, at /blog/tag/ (04/D3): one row per tag with its number of posts, most-used first.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { countPosts, getPosts, getTags, tagUrl } from '../../../lib/posts';

const posts = await getPosts();
const tags = getTags(posts);
---

<BaseLayout title="Tags" description="All the tags on Bimanjaya's blog.">
  <h1>Tags</h1>
  <p class="intro">
    {tags.length} tag{tags.length === 1 ? '' : 's'} · {countPosts(posts.length)}
  </p>

  <ul class="tag-list">
    {tags.map((tag) => (
      <li>
        <a href={tagUrl(tag.name)}>{tag.name}</a>
        <span class="count">{countPosts(tag.posts.length)}</span>
      </li>
    ))}
  </ul>

  <p class="back-links">
    <a href="/blog/">← All posts</a>
  </p>
</BaseLayout>

<style>
  .tag-list {
    margin-top: var(--space-l);
    padding: 0;
    list-style: none;
  }

  /* "thoughts ............ 6 posts": the name left, the count right, a thin line between rows. */
  .tag-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .tag-list a {
    font-size: var(--text-l);
    text-decoration: none;
  }

  .tag-list a:hover {
    text-decoration: underline;
  }

  .count {
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }
</style>
