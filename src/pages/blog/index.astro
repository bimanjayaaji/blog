---
// The blog list: every post, grouped by year, newest first (04/D1). It's also the site's
// front page ("/" forwards here, 03/D5). The list itself is src/components/PostList.astro,
// shared with the tag pages and year pages. The .intro style is in global.css (shared too).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { countPosts, getPosts, postYear } from '../../lib/posts';

const posts = await getPosts();
const firstYear = posts.length > 0 ? postYear(posts[posts.length - 1]) : undefined;
---

<BaseLayout title="Blog" description="Posts by Bimanjaya.">
  <h1>Blog</h1>

  {posts.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <>
      <p class="intro">
        {countPosts(posts.length)} since {firstYear} · <a href="/blog/tag/">all tags</a>
      </p>
      <PostList posts={posts} />
    </>
  )}
</BaseLayout>

