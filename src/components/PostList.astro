---
/*
 * PostList: a list of posts, shared by the blog list (/blog/) and, later, the tag pages (S2)
 * and year pages (S3) of the blog-index feature (04/D1).
 *
 *   groupByYear (default true):  a heading per year ("2025  6 posts", linking to the
 *                                year's page), then that year's posts.
 *   showTags    (default true):  each row ends with its tags as links. A tag page turns
 *                                this off: every row there has the same tag.
 *
 * Each row: the date without its year ("9 Nov": the year is in the heading or the page title),
 * the title, and the tags on a line under the title.
 */
import {
  countPosts,
  formatShortDate,
  groupByYear as splitByYear,
  postUrl,
  tagUrl,
  yearUrl,
  type Post,
} from '../lib/posts';

interface Props {
  posts: Post[];
  groupByYear?: boolean;
  showTags?: boolean;
}

const { posts, groupByYear = true, showTags = true } = Astro.props;
// Without grouping, the posts are one group with no heading, so the rows are written once.
const groups: { year?: number; posts: Post[] }[] = groupByYear ? splitByYear(posts) : [{ posts }];
---

{groups.map(({ year, posts }) => (
  <section class:list={{ year: year !== undefined }} aria-labelledby={year && `year-${year}`}>
    {year !== undefined && (
      <h2 id={`year-${year}`}>
        <a href={yearUrl(year)}>{year}</a>
        <span class="year-count">{countPosts(posts.length)}</span>
      </h2>
    )}
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatShortDate(post.data.date)}</time>
          <span class="title">
            <a href={postUrl(post)} lang={post.data.lang}>{post.data.title}</a>
            {post.data.draft && <span class="draft">draft</span>}
          </span>
          {showTags && post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((tag, i) => (
                <>{i > 0 && ', '}<a href={tagUrl(tag)}>{tag}</a></>
              ))}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
))}

<style>
  .year {
    margin-top: var(--space-xl);
  }

  /* "2025  6 posts", with a thin line under it. */
  .year h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
    font-size: var(--text-l);
    font-weight: 700;
  }

  .year h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .year-count {
    color: var(--color-muted);
    font-size: var(--text-s);
    font-weight: 400;
  }

  .posts {
    margin-top: var(--space-s);
    padding: 0;
    list-style: none;
  }

  /*
   * Two columns at every width: date | title, and the tags on a second line under the title.
   * (Tags beside the title squeezed long titles once a post had several tags: 04/D1.)
   *   9 Nov   Wallpaper of Our Life
   *           thoughts
   */
  .posts li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: baseline;
    column-gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .tags {
    grid-column: 2;
    line-height: 1.4;
  }

  time,
  .tags,
  .draft {
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }

  time {
    color: var(--color-muted);
  }

  /* Titles in the text colour, teal when pointed at (03/D11); same for the year and the tags. */
  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .tags,
  .tags a {
    color: var(--color-muted);
  }

  .tags a {
    text-decoration: none;
  }

  .year h2 a:hover,
  .year h2 a:focus-visible,
  .title a:hover,
  .title a:focus-visible,
  .tags a:hover,
  .tags a:focus-visible {
    color: var(--color-accent);
  }

  .draft {
    margin-left: var(--space-s);
    color: var(--color-accent);
  }
</style>
