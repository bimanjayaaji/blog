---
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();   // evaluated at build time
---

<footer class="site-footer">
  <p>© {year} {SITE.name}</p>
  <SocialLinks />
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;  /* © on the left, icons on the right (stacked on a narrow phone) */
    gap: var(--space-s) var(--space-l);
    width: 100%;                     /* see Header.astro */
    max-width: calc(var(--width-frame) + 2 * var(--gutter));   /* the wider frame */
    margin-inline: auto;
    padding: var(--space-m) var(--gutter);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }

  /* Icons' 44px tap areas: pull the last one's padding out so the icon lines up with the edge. */
  .site-footer :global(.social) {
    margin-right: calc(-1 * var(--space-s));
  }
</style>
