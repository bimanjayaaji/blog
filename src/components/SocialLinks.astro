---

<ul class="social">
  {SOCIAL.map((s) => (
    <li>
      {/* target="_blank": opens in a new tab. noopener: the new tab can't control this one.
          The label tells screen-reader users about the new tab too. */}
      <a href={s.href} target="_blank" rel="me noopener" aria-label={`${s.label} (opens in a new tab)`} title={s.label}>
        <svg viewBox="0 32 448 448" aria-hidden="true" focusable="false">
          <path fill="currentColor" d={ICONS[s.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  /* The link is a 44px square (easy to tap); the icon inside is 22px. */
  a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-muted);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-accent);
  }

  svg {
    width: 1.375rem;
    height: 1.375rem;
  }
</style>
