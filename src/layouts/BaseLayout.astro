---
/*
 * BaseLayout: the shell every page is wrapped in.
 * It owns <html>, <head> (title, meta tags), the header and the footer.
 * A page passes its own content in, which lands where <slot /> is.
 *
 * Usage, in a page:
 *   <BaseLayout title="About" description="Who I am">
 *     <h1>About</h1> ...
 *   </BaseLayout>
 */
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;        // page title; omitted on the home page
  description?: string;  // shown by search engines and link previews
  lang?: string;         // page language; defaults to the site's (posts pass their own)
}

const { title, description = SITE.description, lang = SITE.lang } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Dark mode: re-apply the reader's saved choice (light/dark, from the header toggle)
      before anything is drawn. It's inline (not a separate file) and sits in <head> so it
      runs first: otherwise a dark-mode reader would see a white flash on every page.
      No saved choice → nothing set → the page follows the system setting.
      try/catch: some private windows block localStorage.
    -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    <!-- Fonts (astro.config.mjs): @font-face rules. preload = start downloading early, only
         for the files every page needs at once (italic and bold load when first used). -->
    <Font cssVariable="--font-lora" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-courier-prime" preload={[{ weight: 400 }]} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Centre the content column and keep lines a readable length. */
  main {
    flex: 1;                     /* take the leftover height, pushing the footer down */
    width: 100%;
    max-width: calc(var(--width-text) + 2 * var(--gutter));   /* the padding sits inside max-width */
    margin-inline: auto;
    padding: var(--space-l) var(--gutter) var(--space-xl);
  }
</style>
