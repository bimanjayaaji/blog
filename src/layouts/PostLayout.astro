---
/*
 * PostLayout: wraps a single post. It sits inside BaseLayout (header, footer, <head>)
 * and adds the post's title, date and tags above the body.
 */
import BaseLayout from './BaseLayout.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, description, tags, draft, lang } = post.data;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article>
    <header class="post-header">
      {draft && <p class="draft-badge">Draft: not published</p>}
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {tags.length > 0 && <span> · {tags.join(', ')}</span>}
      </p>
    </header>

    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-l);
  }

  .post-meta {
    margin-top: var(--space-s);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }

  .draft-badge {
    display: inline-block;
    margin-bottom: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-radius: 4px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: var(--text-s);
  }
</style>
