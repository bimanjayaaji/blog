---
/*
 * PostLayout: wraps a single post. It sits inside BaseLayout (header, footer, <head>)
 * and adds the post's title, date and tags (linking to their tag pages, 04/D5) above the body, and links to the
 * previous (older) and next (newer) post below it (03/D6).
 */
import BaseLayout from './BaseLayout.astro';
import { formatDate, postUrl, tagUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  previous?: Post;   // older post, if any
  next?: Post;       // newer post, if any
}

const { post, previous, next } = Astro.props;
const { title, date, description, tags, draft, lang } = post.data;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article>
    <header class="post-header">
      {draft && <p class="draft-badge">Draft: not published</p>}
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {tags.length > 0 && (
          <span>
            {' · '}
            {tags.map((tag, i) => (
              <>{i > 0 && ', '}<a href={tagUrl(tag)}>{tag}</a></>
            ))}
          </span>
        )}
      </p>
    </header>

    <div class="post-body">
      <slot />
    </div>

    {(previous || next) && (
      <nav class="post-nav" aria-label="More posts">
        {previous && (
          <a class="post-nav-link prev" href={postUrl(previous)} rel="prev">
            <span class="post-nav-label">← Previous</span>
            <span class="post-nav-title" lang={previous.data.lang}>{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="post-nav-link next" href={postUrl(next)} rel="next">
            <span class="post-nav-label">Next →</span>
            <span class="post-nav-title" lang={next.data.lang}>{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  /* Title, date and tags centred above the post, like the old site's post titles (04/D6). */
  .post-header {
    margin-bottom: var(--space-l);
    text-align: center;
  }

  .post-meta {
    margin-top: var(--space-s);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }

  /* Previous / Next: side by side (older left, newer right), stacked on phones. */
  .post-nav {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 36rem) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-nav-link {
    display: grid;
    gap: var(--space-xs);
    text-decoration: none;
  }

  .next {
    grid-column: -2;               /* stays on the right even when there is no Previous */
    text-align: right;
  }

  .post-nav-label {
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--text-s);
  }

  .post-nav-title {
    color: var(--color-text);
    line-height: 1.4;
  }

  .post-nav-link:hover .post-nav-title,
  .post-nav-link:focus-visible .post-nav-title {
    color: var(--color-accent);
  }

  .draft-badge {
    display: inline-block;
    margin-bottom: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-radius: 4px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: var(--text-s);
  }
</style>
