{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      // Shortcut for the shared images folder (D7): in a post, write
      // ![alt](@images/<post>/photo.jpg) instead of ../../assets/images/<post>/photo.jpg
      "@images/*": ["./src/assets/images/*"]
    }
  }
}
